# ==================================================================
### Test 17: Categoría GENERAL - Pregunta sin keywords específicas
# Verifica:
#   - category: "general"
#   - method puede ser "random" o "fallback-general"
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-general

{
  "question": "¿Hola, estás ahí?",
  "personality": "playful",
  "language": "es"
}


# ==================================================================
# VALIDACIONES ESPERADAS
# ==================================================================
# ✅ Cada pregunta debe clasificarse correctamente en su categoría
# ✅ Las keywords matcheadas deben corresponder a la categoría detectada
# ✅ method debe ser "keyword-match" cuando hay keywords relevantes
# ✅ matchScore debe ser > 0 cuando hay keywords matcheadas
# ✅ category puede ser: love, career, health, family, death, future, money, spirituality, general
