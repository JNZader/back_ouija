# ==================================================================
# OUIJA - TESTS DE CATEGORÍAS
# ==================================================================
# Pruebas de clasificación de preguntas en diferentes categorías

@baseUrl = http://localhost:3001
@sessionId = categories-test-{{$timestamp}}

# ==================================================================
# Categoría: LOVE (Amor)
# ==================================================================
### Test 1: Categoría LOVE - Pregunta sobre amor
# Keywords esperadas: amor, pareja, relación, corazón, sentimientos
# Verifica:
#   - category: "love"
#   - matchedKeywords incluye términos de amor
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-love

{
  "question": "¿Encontraré el amor verdadero pronto?",
  "personality": "wise",
  "language": "es"
}


### Test 2: Categoría LOVE - Pregunta sobre relación
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-love

{
  "question": "¿Mi relación de pareja durará para siempre?",
  "personality": "cryptic",
  "language": "es"
}


