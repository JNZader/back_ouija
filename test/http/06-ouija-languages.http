# ==================================================================
# Tests de Idioma por Defecto
# ==================================================================

### Test 5: Sin especificar idioma - Debe usar por defecto
# Verifica:
#   - language: valor por defecto (probablemente "es")
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-default-lang

{
  "question": "¿Qué idioma usarás?"
}


# ==================================================================
# Tests de Normalización Multiidioma
# ==================================================================

### Test 6a: Normalización ES - Acentos y mayúsculas
# Verifica:
#   - Keywords normalizadas correctamente
#   - Acentos removidos para matching
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-normalize-es

{
  "question": "¿ENCONTRARÉ el AMOR de mi VIDA con PAREJA?",
  "personality": "wise",
  "language": "es"
}


### Test 6b: Normalización EN - Mayúsculas
# Verifica:
#   - Keywords normalizadas correctamente
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-normalize-en

{
  "question": "WILL I FIND TRUE LOVE with MY PARTNER?",
  "personality": "wise",
  "language": "en"
}


# ==================================================================
# Tests de Fallback por Idioma
# ==================================================================

### Test 7a: Fallback ES - Categoría sin respuestas
# Nota: Este test puede fallar al fallback si no hay respuestas
# seeded para cierta combinación de personality-language-category
# Verifica:
#   - Cascada a GENERAL si no hay respuestas específicas
#   - metadata.cascadeFrom presente si hizo fallback
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-fallback-es

{
  "question": "pregunta muy específica sin keywords",
  "personality": "wise",
  "language": "es"
}


### Test 7b: Fallback EN - Categoría sin respuestas
# Nota: English tiene menos respuestas seeded
# Verifica:
#   - Cascada a GENERAL o respuesta genérica hardcoded
#   - method puede ser "fallback-general"
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-fallback-en

{
  "question": "very specific question without keywords",
  "personality": "wise",
  "language": "en"
}


# ==================================================================
# Tests de Sesiones Independientes por Idioma
# ==================================================================

### Test 8a: Sesión ES - Primera pregunta
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-lang-session

{
  "question": "¿Encontraré el amor?",
  "personality": "wise",
  "language": "es"
}


### Test 8b: Sesión EN - Primera pregunta (misma sesión)
# Verifica:
#   - Las respuestas en ES no afectan las respuestas en EN
#   - availableResponses independiente por idioma
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-lang-session

{
  "question": "Will I find love?",
  "personality": "wise",
  "language": "en"
}


### Test 8c: Sesión ES - Segunda pregunta
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-lang-session

{
  "question": "¿Encontraré el amor?",
  "personality": "wise",
  "language": "es"
}


### Test 8d: Sesión EN - Segunda pregunta
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-lang-session

{
  "question": "Will I find love?",
  "personality": "wise",
  "language": "en"
}


# ==================================================================
# Tests de Coverage de Seed Data
# ==================================================================

### Test 9: Verificar distribución de respuestas por idioma
# Endpoint: GET /ouija/responses/stats
# Verifica:
#   - database.byLanguage debe mostrar:
#     - es: ~60+ respuestas
#     - en: ~2-3 respuestas (según CLAUDE.md)
#   - Importante: Inglés tiene menos cobertura
GET {{baseUrl}}/ouija/responses/stats


# ==================================================================
# VALIDACIONES ESPERADAS
# ==================================================================
# ✅ Respuestas deben estar en el idioma especificado
# ✅ Keywords deben matchearse en el idioma correcto
# ✅ Clasificación debe funcionar en ambos idiomas
# ✅ Normalización debe remover acentos y convertir a minúsculas
# ✅ Sesiones independientes por idioma
# ✅ Fallback a GENERAL o genérico si no hay respuestas
# ⚠️  IMPORTANTE: English tiene menos respuestas seeded (ver CLAUDE.md)
# ⚠️  Puede haber más fallbacks en inglés debido a falta de seed data
# ✅ GET /ouija/responses/stats debe mostrar distribución por idioma
