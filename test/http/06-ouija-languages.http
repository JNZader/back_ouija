# ==================================================================
# Tests de Clasificación Bilingüe
# ==================================================================

### Test 3a: Clasificación ES - Amor
# Verifica:
#   - category: "love"
#   - Keywords en español detectadas correctamente
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-classify-es

{
  "question": "Mi pareja y yo tenemos problemas de amor",
  "personality": "cryptic",
  "language": "es"
}


### Test 3b: Clasificación EN - Amor
# Verifica:
#   - category: "love"
#   - Keywords en inglés detectadas correctamente
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-classify-en

{
  "question": "My partner and I have relationship issues",
  "personality": "cryptic",
  "language": "en"
}


### Test 3c: Clasificación ES - Trabajo
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-classify-es

{
  "question": "Mi jefe me dará un ascenso en mi carrera",
  "personality": "cryptic",
  "language": "es"
}


### Test 3d: Clasificación EN - Trabajo
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-classify-en

{
  "question": "My boss will give me a promotion in my career",
  "personality": "cryptic",
  "language": "en"
}


