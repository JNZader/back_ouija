# ==================================================================
# OUIJA - TESTS DE IDIOMAS
# ==================================================================
# Pruebas de soporte multiidioma (español e inglés)

@baseUrl = http://localhost:3001
@sessionId = languages-test-{{$timestamp}}

# ==================================================================
# Español (ES) - Tests Completos
# ==================================================================

### Test 1a: Español - Pregunta sobre amor
# Verifica:
#   - language: "es"
#   - Respuesta en español
#   - Keywords en español: amor, pareja, etc.
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-es-love

{
  "question": "¿Encontraré el amor de mi vida?",
  "personality": "wise",
  "language": "es"
}


### Test 1b: Español - Pregunta sobre carrera
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-es-career

{
  "question": "¿Tendré éxito en mi trabajo?",
  "personality": "wise",
  "language": "es"
}


### Test 1c: Español - Pregunta sobre salud
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-es-health

{
  "question": "¿Mejoraré de mi enfermedad?",
  "personality": "wise",
  "language": "es"
}


### Test 1d: Español - Pregunta sobre familia
POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-es-family

{
  "question": "¿Cómo está mi familia?",
  "personality": "wise",
  "language": "es"
}


