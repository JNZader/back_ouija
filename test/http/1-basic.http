###
# 1. TESTS BÁSICOS
# Pruebas fundamentales del endpoint principal
###

@baseUrl = {{$dotenv baseUrl}}
@sessionId = {{$dotenv sessionId}}

###############################################################################
### Test 1.1: Pregunta básica sin personalidad
###############################################################################
# Verifica:
#   - El sistema asigna una personalidad aleatoriamente
#   - Retorna respuesta válida
#   - Status 201

POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-basic-1

{
  "question": "¿Funcionará esta extensión?",
  "language": "es"
}

###############################################################################
### Test 1.2: Pregunta básica CON personalidad especificada
###############################################################################
# Verifica:
#   - Usa la personalidad solicitada
#   - Respuesta coherente con personalidad wise

POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-basic-2

{
  "question": "¿Qué me depara el futuro?",
  "personality": "wise",
  "language": "es"
}

###############################################################################
### Test 1.3: Pregunta en inglés
###############################################################################
# Verifica:
#   - Soporta idioma inglés
#   - Retorna respuesta en inglés

POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-basic-3

{
  "question": "Will I find love?",
  "personality": "wise",
  "language": "en"
}

###############################################################################
### Test 1.4: Validación - Pregunta muy corta (debe fallar)
###############################################################################
# Verifica:
#   - Status 400 (Bad Request)
#   - Mensaje de error apropiado

POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-validation-1

{
  "question": "¿?",
  "language": "es"
}

###############################################################################
### Test 1.5: Validación - Pregunta muy larga (debe fallar)
###############################################################################
# Verifica:
#   - Status 400 (Bad Request)
#   - Respeta límite de 200 caracteres

POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-validation-2

{
  "question": "Lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore magna aliqua ut enim ad minim veniam quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur excepteur sint occaecat cupidatat non proident sunt in culpa qui officia deserunt mollit anim id est laborum",
  "language": "es"
}

###############################################################################
### Test 1.6: Validación - Personalidad inválida (debe fallar)
###############################################################################
# Verifica:
#   - Status 400
#   - Error de validación de enum

POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-validation-3

{
  "question": "¿Tendré suerte?",
  "personality": "super-wise",
  "language": "es"
}

###############################################################################
### Test 1.7: Validación - Idioma inválido (debe fallar)
###############################################################################
# Verifica:
#   - Status 400
#   - Error de validación de idioma

POST {{baseUrl}}/ouija/ask
Content-Type: application/json
X-Session-Id: {{sessionId}}-validation-4

{
  "question": "¿Tendré suerte?",
  "personality": "wise",
  "language": "fr"
}
