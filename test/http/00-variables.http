# ==================================================================
# VARIABLES GLOBALES PARA TODOS LOS TESTS
# ==================================================================
# Estas variables se pueden usar en todos los archivos .http del proyecto
# Sintaxis: {{nombreVariable}}

@baseUrl = http://localhost:3001
@sessionId = test-user-{{$timestamp}}
@contentType = application/json

# Variables para diferentes usuarios
@user1 = user-test-1
@user2 = user-test-2
@user3 = user-test-3
@userMulti = user-multi-{{$timestamp}}

# Variables para diferentes personalidades
@wisePersonality = wise
@crypticPersonality = cryptic
@darkPersonality = dark
@playfulPersonality = playful

# Variables para idiomas
@spanish = es
@english = en

# ==================================================================
# INSTRUCCIONES DE USO
# ==================================================================
# 1. Instala la extensión "REST Client" en VSCode
# 2. Asegúrate de que el servidor esté corriendo: npm run start:dev
# 3. Abre cualquier archivo .http de la carpeta test/http/
# 4. Haz clic en "Send Request" sobre cada petición
# 5. Verifica los resultados según las notas de cada test
# ==================================================================
