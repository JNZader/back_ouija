# ==============================================
# OUIJA VIRTUAL - Backend Configuration
# ==============================================

# -----------------
# Server
# -----------------
# Environment: development, production, test
NODE_ENV=development

# Server port
PORT=3001

# -----------------
# Database
# -----------------
# SQLite database path (file:./path) or PostgreSQL connection string
DATABASE_URL="file:./dev.db"

# -----------------
# CORS Configuration
# -----------------
# Comma-separated list of allowed origins (protocols required: http:// or https://)
# Examples:
#   Development: http://localhost:3000,http://localhost:5173
#   Production:  https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------
# Rate Limiting (Anti-DDoS & Anti-Spam)
# -----------------
# These limits are applied PER IP ADDRESS
# All three limits are checked simultaneously

# Short window: Fast spam protection (3 requests per second)
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=3

# Medium window: Moderate usage protection (20 requests per 10 seconds)
THROTTLE_MEDIUM_TTL=10000
THROTTLE_MEDIUM_LIMIT=20

# Long window: General traffic protection (100 requests per minute)
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=100

# ----------------------------------------------
# SonarQube (optional - for local analysis)
# ----------------------------------------------
SONAR_TOKEN=your-sonarqube-token-here
SONAR_HOST_URL=http://127.0.0.1:9000
SONAR_PROJECT_KEY=OiujaAPI